###
# Create an Asset 
# @name createAsset

POST http://localhost:3000/assets
Content-Type: application/json

{
    "name": "Test",
    "symbol": "T1",
    "price": 100,
    "image": "TST.png"
}

###

@assetId = {{ createAsset.response.body._id }}

###
# Look for an specific asset

GET http://localhost:3000/assets/{{assetId}}

###
# Look all assets

GET http://localhost:3000/assets

###
# Create a wallet
# @name createWallet
POST http://localhost:3000/wallets
Content-Type: application/json

###

@walletId = {{ createWallet.response.body._id }}

###
# Get an wallet by it's id

GET http://localhost:3000/wallets/{{walletId}}

###
# Get all wallets

GET http://localhost:3000/wallets

###
# Create a Wallet Asset resource

POST http://localhost:3000/wallets/{{walletId}}/assets
Content-Type: application/json

{
    "assetId": "{{assetId}}",
    "shares": 100
}

###
# Create an order

POST http://localhost:3000/orders
Content-Type: application/json

{
    "walletId": "{{walletId}}",
    "assetId": "{{assetId}}",
    "shares": 10,
    "price": 32.00,
    "type": "BUY"
}

###
# Return the order by id
GET http://localhost:3000/orders?walletId={{walletId}}